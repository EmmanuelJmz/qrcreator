# En Vercel configura estas variables en Project Settings -> Environment Variables
# (no necesitas crear un archivo .env en el repositorio).

# APP_URL: Opcional. Base URL pública para los QR (si se omite usa el dominio actual).
APP_URL="http://localhost:3000"
PORT="3000"

# Neon PostgreSQL Roles (least privilege; schema applied by neondb_owner)
# DATABASE_URL        -> rol cascoqr_admin_app (solo rutas administrativas /api/v1/*)
# DATABASE_PUBLIC_URL -> rol cascoqr_public_app (solo ejecuta funciones SECURITY DEFINER públicas)
DATABASE_URL="postgresql://cascoqr_admin_app:PASSWORD@ep-wandering-water-bdrfb5k6-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_PUBLIC_URL="postgresql://cascoqr_public_app:PASSWORD@ep-wandering-water-bdrfb5k6-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-wandering-water-bdrfb5k6.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Single Administrator Credentials (NO administrators table in DB)
ADMIN_USERNAME="admin"
# Set either ADMIN_PASSWORD_HASH (scrypt$<saltHex>$<hashHex>) or ADMIN_PASSWORD
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""

# Server Secret Keys (OBLIGATORIAS en Vercel/producción; 64 hex chars recomendados)
SESSION_SECRET="CHANGE_ME_SESSION_SECRET_64_HEX"
TOKEN_ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS"

# Private File Storage: Cloudflare R2 S3-compatible bucket (default: "r2")
STORAGE_DRIVER="r2"
R2_S3_API_URL="https://e749a5c3d625e2a80eef9b33b5a97e31.r2.cloudflarestorage.com/qrimages"
R2_ENDPOINT="https://e749a5c3d625e2a80eef9b33b5a97e31.r2.cloudflarestorage.com"
R2_BUCKET="qrimages"
R2_REGION="auto"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
